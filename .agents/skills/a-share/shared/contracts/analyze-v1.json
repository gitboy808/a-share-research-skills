{
  "schema_version": "a-share-task-contract-v1",
  "contract_id": "analyze.default",
  "version": "1.0.0",
  "workflow": "analyze",
  "stage": "analysis",
  "unknown_policy": "abstain_if_critical",
  "blocking": "block_only_on_required_missing",
  "required_evidence": [
    {
      "requirement_id": "verified-object-facts",
      "unit_type": "evidence_item",
      "evidence_role": "primary",
      "bind_to_run_objects": true,
      "bind_to_handoff": "evidence_ids",
      "eligibility_mode": "prospective_current",
      "required": true,
      "allow_unknown": false
    },
    {
      "requirement_id": "counterevidence",
      "unit_type": "evidence_item",
      "evidence_role": "veto",
      "bind_to_run_objects": true,
      "bind_to_handoff": "evidence_ids",
      "eligibility_mode": "prospective_current",
      "required": true,
      "allow_unknown": true
    },
    {
      "requirement_id": "current-object-dossier",
      "unit_type": "object_field",
      "bind_to_run_objects": true,
      "eligibility_mode": "prospective_current",
      "required": true,
      "allow_unknown": false
    },
    {
      "requirement_id": "active-judgment-chain",
      "unit_type": "judgment_version",
      "bind_to_run_objects": true,
      "eligibility_mode": "prospective_current",
      "required": true,
      "allow_unknown": true
    },
    {
      "requirement_id": "exact-strategy-version",
      "unit_type": "strategy_version",
      "bind_to_strategy_version": true,
      "eligibility_mode": "prospective_current",
      "allowed_lifecycle_statuses": ["trial", "official", "limited"],
      "required": true,
      "allow_unknown": false
    }
  ]
}
